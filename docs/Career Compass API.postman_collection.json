{
  "info": {
    "name": "CareerCompass API",
    "description": "Postman collection for the CareerCompass Spring Boot API.\n\nHow to use:\n1. Run the app locally (default http://localhost:8080) with MySQL and a Gemini key configured.\n2. Run Auth > Register once, then Auth > Login. The token and userId are stored automatically.\n3. Run any other request.\n\nDemo credentials only. Change baseUrl in the collection Variables tab if your app runs on another port.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Create a demo user. Public endpoint.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"Demo@1234\",\n  \"degreeType\": \"BTECH\",\n  \"specialization\": \"Computer Science\",\n  \"passoutYear\": 2023,\n  \"skills\": \"Java, Spring Boot, MySQL\",\n  \"jobTarget\": \"Java Developer\",\n  \"isGapCandidate\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Log in with the demo user. The JWT and userId are saved automatically to collection variables, so every other request works after this one.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"Demo@1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const r = pm.response.json();",
                  "    pm.collectionVariables.set('token', r.token);",
                  "    pm.collectionVariables.set('userId', r.userId);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Roadmap",
